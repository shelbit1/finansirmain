# Скопируйте в .env.local (локально) и в Environment вашего хостинга.
# Не коммитьте реальные значения в git.

# ─── Supabase: база данных (Prisma) ─────────────────────────────────────────
# Dashboard → Connect → ORMs (Prisma). Пароль БД задаётся в Project Settings →
# Database. PROJECT_REF — это поддомен из NEXT_PUBLIC_SUPABASE_URL.
#
# DATABASE_URL — пул соединений (Transaction pooler, порт 6543), для рантайма.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL — прямое соединение (порт 5432), для миграций и `prisma db push`.
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ─── Supabase: аутентификация (клиент) ──────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Секретный ключ (service role). ТОЛЬКО на сервере — нужен для удаления аккаунта
# (auth.admin.deleteUser). Никогда не префиксуйте его NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Публичный URL приложения, например https://finansir.up.railway.app
APP_URL=

# T-Bank (оплата подписки)
TBANK_TERMINAL_KEY=
TBANK_PASSWORD=
TBANK_API_URL=https://securepay.tinkoff.ru/v2

# Яндекс.Метрика (аналитика; к базе/авторизации отношения не имеет)
NEXT_PUBLIC_YM_ID=

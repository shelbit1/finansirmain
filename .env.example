# Переменные для Amvera Cloud (Settings → Environment)
# Скопируйте шаблон и заполните значения без коммита в git

# PostgreSQL (обязательно на Amvera). После изменения — перезапуск контейнера.
#
# Amvera managed PG (внутренний хост из «Инфо» кластера):
# DATABASE_URL=postgresql://USER:PASSWORD@amvera-PROJECT-cnpg-XXX-rw:5432/DBNAME
#
# Yandex Managed PostgreSQL (добавьте IP Amvera в allow-list кластера):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:6432/DB?sslmode=require
# С проверкой CA (файл prisma/yandex-root.crt копируется в standalone при сборке):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:6432/DB?sslmode=verify-full&sslrootcert=./prisma/yandex-root.crt
DATABASE_URL=

# В проекте для сессий используется SESSION_SECRET (не NextAuth)
SESSION_SECRET=

# Публичный URL приложения, например https://finansir.amvera.app
APP_URL=

# Из шаблона (если нужны для других интеграций — дублируют APP_URL / SESSION_SECRET)
NEXTAUTH_SECRET=
NEXTAUTH_URL=

NEXT_PUBLIC_YM_ID=

# T-Bank (оплата подписки)
TBANK_TERMINAL_KEY=
TBANK_PASSWORD=
TBANK_API_URL=https://securepay.tinkoff.ru/v2

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Supabase: пул соединений (Transaction pooler, порт 6543) для рантайма.
  url       = env("DATABASE_URL")
  // Прямое соединение (порт 5432) для миграций и `prisma db push`.
  directUrl = env("DIRECT_URL")
}

// ─── ПОЛЬЗОВАТЕЛЬ ────────────────────────────────────────────────────────────

model User {
  // = auth.users.id из Supabase Auth (UUID, хранится строкой). Пароль и
  // аутентификация управляются Supabase Auth, в этой таблице — только профиль.
  id        String   @id
  email     String   @unique
  name      String?
  // Юридические согласия
  consentAcceptedAt DateTime?
  marketingConsent  Boolean   @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts          Account[]
  incomeCategories  IncomeCategory[]
  expenseCategories ExpenseCategory[]
  transactions      Transaction[]
  dailyCheckIns     DailyCheckIn[]
  debts             Debt[]
  assets            Asset[]
  assetValueHistory AssetValueHistory[]
  plans             Plan[]
  subscription      Subscription?
  payments          Payment[]
}

// ─── ПОДПИСКА И ПЛАТЕЖИ ──────────────────────────────────────────────────────

enum SubscriptionStatus {
  TRIALING  // активен пробный период
  ACTIVE    // оплачен, идёт оплаченный период
  PAST_DUE  // период истёк, оплаты нет
  CANCELED  // отменена пользователем, действует до конца периода
}

model Subscription {
  id               String             @id @default(cuid())
  userId           String             @unique
  status           SubscriptionStatus @default(TRIALING)
  trialEndsAt      DateTime?
  currentPeriodEnd DateTime?
  canceledAt       DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
}

enum PaymentStatus {
  NEW
  FORM_SHOWED
  AUTHORIZED
  CONFIRMED
  REJECTED
  REFUNDED
  CANCELED
}

model Payment {
  id             String        @id @default(cuid())
  userId         String
  orderId        String        @unique // наш external_id, передаваемый в T-Bank как OrderId
  amount         Decimal       @db.Decimal(18, 2)
  currency       String        @default("RUB")
  status         PaymentStatus @default(NEW)
  description    String?
  periodMonths   Int           @default(1)
  tbankPaymentId String?       @unique
  tbankStatus    String?
  paymentUrl     String?
  paidAt         DateTime?
  errorCode      String?
  errorMessage   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

// ─── СЧЁТ ────────────────────────────────────────────────────────────────────

model Account {
  id        String   @id @default(cuid())
  userId    String
  name      String
  currency  String   @default("RUB")
  balance   Decimal  @default(0) @db.Decimal(18, 2)
  icon      String?
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactionsFrom Transaction[] @relation("FromAccount")
  transactionsTo   Transaction[] @relation("ToAccount")

  @@index([userId])
}

// ─── КАТЕГОРИИ ───────────────────────────────────────────────────────────────

model IncomeCategory {
  id        String   @id @default(cuid())
  userId    String
  name      String
  icon      String?
  color     String?
  parentId  String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent       IncomeCategory?  @relation("IncomeCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     IncomeCategory[] @relation("IncomeCategoryTree")
  transactions Transaction[]

  @@index([userId])
  @@index([parentId])
}

model ExpenseCategory {
  id        String   @id @default(cuid())
  userId    String
  name      String
  icon      String?
  color     String?
  parentId  String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent       ExpenseCategory?  @relation("ExpenseCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     ExpenseCategory[] @relation("ExpenseCategoryTree")
  transactions Transaction[]

  @@index([userId])
  @@index([parentId])
}

// ─── ОПЕРАЦИИ ────────────────────────────────────────────────────────────────

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
  DEBT_TAKE     // Я взял в долг (+balance)
  DEBT_RETURN   // Я вернул долг — тело (−balance)
  DEBT_GIVE     // У меня взяли в долг (−balance)
  DEBT_RECEIVE  // Мне вернули долг (+balance)
  ASSET_BUY     // Покупка актива со счёта (−balance, +asset)
}

model Transaction {
  id     String          @id @default(cuid())
  userId String
  type   TransactionType
  amount Decimal         @db.Decimal(18, 2)
  date   DateTime
  note   String?

  incomeCategoryId String?
  incomeCategory   IncomeCategory? @relation(fields: [incomeCategoryId], references: [id], onDelete: SetNull)
  toAccountId      String?
  toAccount        Account?        @relation("ToAccount", fields: [toAccountId], references: [id], onDelete: SetNull)

  expenseCategoryId String?
  expenseCategory   ExpenseCategory? @relation(fields: [expenseCategoryId], references: [id], onDelete: SetNull)
  fromAccountId     String?
  fromAccount       Account?         @relation("FromAccount", fields: [fromAccountId], references: [id], onDelete: SetNull)

  // Связка «тело долга → проценты»: дочерняя запись удаляется каскадом
  parentId String?
  parent   Transaction?  @relation("DerivedTransactions", fields: [parentId], references: [id], onDelete: Cascade)
  derived  Transaction[] @relation("DerivedTransactions")

  // Связь с разделом «Долги»: операции TAKE/GIVE создают Debt, RETURN/RECEIVE → DebtPayment
  debtId        String?
  debt          Debt?        @relation(fields: [debtId], references: [id], onDelete: SetNull)
  debtPaymentId String?
  debtPayment   DebtPayment? @relation(fields: [debtPaymentId], references: [id], onDelete: SetNull)

  // Связь с разделом «Активы»: операция ASSET_BUY создаёт Asset
  assetId String?
  asset   Asset?  @relation(fields: [assetId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([type])
  @@index([parentId])
  @@index([debtId])
  @@index([assetId])
}

// ─── ЕЖЕДНЕВНАЯ ПАМЯТКА ──────────────────────────────────────────────────────

model DailyCheckIn {
  id        String   @id @default(cuid())
  userId    String
  date      String   // YYYY-MM-DD
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

// ─── ДОЛГИ ───────────────────────────────────────────────────────────────────

enum DebtDirection {
  I_OWE
  OWED_TO_ME
}

enum DebtStatus {
  ACTIVE
  PARTIALLY_PAID
  CLOSED
}

model Debt {
  id          String        @id @default(cuid())
  userId      String
  direction   DebtDirection
  personName  String
  amount      Decimal       @db.Decimal(18, 2)
  currency    String        @default("RUB")
  dueDate     DateTime?
  description String?
  status      DebtStatus    @default(ACTIVE)
  paidAmount  Decimal       @default(0) @db.Decimal(18, 2)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments     DebtPayment[]
  transactions Transaction[]

  @@index([userId, status])
}

model DebtPayment {
  id        String   @id @default(cuid())
  debtId    String
  amount    Decimal  @db.Decimal(18, 2)
  date      DateTime
  note      String?
  createdAt DateTime @default(now())

  debt         Debt          @relation(fields: [debtId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([debtId, date])
}

// ─── ПЛАНЫ ───────────────────────────────────────────────────────────────────

enum PlanType {
  PLAN_INCOME
  PLAN_EXPENSE
}

model Plan {
  id          String    @id @default(cuid())
  userId      String
  type        PlanType
  title       String
  amount      Decimal   @db.Decimal(18, 2)
  currency    String    @default("RUB")
  dueDate     DateTime?
  note        String?
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, completed])
  @@index([userId, type])
}

// ─── АКТИВЫ ──────────────────────────────────────────────────────────────────

enum AssetType {
  REAL_ESTATE
  VEHICLE
  STOCKS
  CRYPTO
  DEPOSIT
  BUSINESS
  PRECIOUS
  OTHER
}

model Asset {
  id            String    @id @default(cuid())
  userId        String
  name          String
  type          AssetType
  purchasePrice Decimal   @db.Decimal(18, 2)
  currentValue  Decimal   @db.Decimal(18, 2)
  currency      String    @default("RUB")
  purchaseDate  DateTime?
  quantity      Decimal?  @default(1) @db.Decimal(18, 4)
  unit          String?
  description   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  valueHistory AssetValueHistory[]
  transactions Transaction[]

  @@index([userId, type])
}

model AssetValueHistory {
  id        String   @id @default(cuid())
  assetId   String
  userId    String
  value     Decimal  @db.Decimal(18, 2)
  date      DateTime
  note      String?
  createdAt DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([assetId, date])
}
